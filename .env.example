# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="https://paygo-pearl.vercel.app"

# BETTER_AUTH_URL: Better Auth Base URL
BETTER_AUTH_URL="https://paygo-pearl.vercel.app"

# TELEGRAM_BOT_USERNAME: The username of the Telegram Bot
TELEGRAM_BOT_USERNAME="Pay_Gouzbot"

# TELEGRAM_BOT_TOKEN: Bot token from @BotFather
TELEGRAM_BOT_TOKEN=""

# ADMIN_TELEGRAM_ID: Super Admin Telegram ID
ADMIN_TELEGRAM_ID="8021115446"
